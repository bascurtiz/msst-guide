# The stager's output. Rebuilt from the repository by
# `node tools/deploy-pages.mjs`, so it is an artifact, not source.
dist/

# Local credentials. Listed by name so a stray `git add -A` cannot publish
# them: this repository is public.
DO-NOT-UPLOAD.txt

# Site bundles exported from the CMS (Data workspace → Export site). One of these
# is the guide's whole content and media in a single zip, it is public-repo-sized,
# and it is only ever a way to carry the site to a host — so keep it out of git.
# admin/MOVING-THE-CMS.md is where it goes instead.
export/
site-bundle-*.zip

# Editor/agent scratch and any local installs.
.freebuff/
node_modules/
